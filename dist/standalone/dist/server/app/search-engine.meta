{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/search-engine/layout,_N_T_/search-engine/page,_N_T_/search-engine"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/search-engine/__PAGE__",
    "/search-engine",
    "/_index",
    "/_head"
  ]
}